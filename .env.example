# Copy to /docker-data/stacks/authentik-netcup/.env; never commit that file.
COMPOSE_PROJECT_NAME=authentik-netcup
DATA_DIR=/docker-data/authentik-netcup
AUTHENTIK_HOST_IP=10.10.10.100
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_VERSION=2026.2.4
POSTGRES_VERSION=16-alpine
REDIS_VERSION=8-alpine
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# Generate once with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET
# Keep this under 99 characters. Generate once; do not rotate casually.
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD
POSTGRES_DB=authentik
POSTGRES_USER=authentik
AUTHENTIK_HOST=https://auth.serveftp.org
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=authentik@serveftp.org
# Leave empty until the exact source CIDR seen by Authentik is verified.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=
BACKUP_DESTINATION=
BACKUP_RETENTION_DAYS=14
